# Postgres connection string (Supabase / Neon free tier) — use the *pooler*
# connection string, not the direct one (see HANDOFF.md's Known Issues).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Google Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"

# Meta WhatsApp Cloud API — https://developers.facebook.com/apps
WHATSAPP_VERIFY_TOKEN="choose-any-random-string"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# App Secret (Meta App Dashboard -> Settings -> Basic) — enables webhook
# X-Hub-Signature-256 verification. Optional: if unset, the webhook still
# works but every request's signature check is skipped (a startup warning
# is logged). Strongly recommended in production.
WHATSAPP_APP_SECRET=""

# Auth for dashboard APIs — must NOT be left as the placeholder below in
# production; the server refuses to start with this exact value when
# NODE_ENV=production (see lib/env.ts).
JWT_SECRET="change-me-to-a-long-random-string"

# Google Sign-In for Owner/Super Admin login (optional — omit to disable
# Google sign-in; phone+password / email+password still work without it)
GOOGLE_CLIENT_ID=""

PORT=3000
