# Postgres connection string (Supabase / Neon free tier) — use the *pooler*
# connection string, not the direct one (see HANDOFF.md's Known Issues).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Google Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"

# Meta WhatsApp Cloud API — https://developers.facebook.com/apps
WHATSAPP_VERIFY_TOKEN="choose-any-random-string"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Auth for dashboard APIs
JWT_SECRET="change-me-to-a-long-random-string"

# Google Sign-In for Owner/Super Admin login (optional — omit to disable
# Google sign-in; phone+password / email+password still work without it)
GOOGLE_CLIENT_ID=""

PORT=3000
