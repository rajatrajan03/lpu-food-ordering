generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  placed
  accepted
  rejected
  preparing
  ready
  completed
  cancelled
}

enum StallStatus {
  active
  paused
}

enum MealPeriod {
  breakfast
  lunch
  snacks
  dinner
}

// Only asked of the student when they give 3 stars or fewer — matches the
// reason options actually offered in the WhatsApp flow (see ai/tools.ts).
enum RatingReason {
  food_quality
  service
  pickup_delay
  wrong_order
  other
}

model Student {
  id                 String   @id @default(uuid())
  whatsappNumber     String   @unique @map("whatsapp_number")
  name               String?
  // Stored as given at onboarding — never validated/verified against any
  // university system, per product decision. Null until onboarding completes.
  registrationNumber String?  @map("registration_number")
  preferredLanguage  String   @default("en") @map("preferred_language")
  // Draft cart, active stall context, and short rolling conversation window.
  // Kept as JSON because it's read/written as a whole per turn, not queried by field.
  sessionState       Json?    @map("session_state")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  lastSeen           DateTime @default(now()) @map("last_seen")

  orders     Order[]
  preference StudentPreference?
  ratings    Rating[]

  @@map("students")
}

// Learned ordering habits, recomputed from a student's completed orders
// after every completion (see orderService.transitionOrderStatus). Never
// hand-edited — purely derived data, safe to recompute from scratch anytime.
model StudentPreference {
  id                 String      @id @default(uuid())
  studentId          String      @unique @map("student_id")
  favoriteStallId    String?     @map("favorite_stall_id")
  favoriteMealPeriod MealPeriod? @map("favorite_meal_period")
  // Derived from the favorite stall's own area/block — "pickup location" in
  // this system is inherently a stall's location, there's no separate
  // campus-location entity independent of stalls.
  preferredArea      String?     @map("preferred_area")
  preferredBlock     String?     @map("preferred_block")
  // The most frequently repeated exact combination of items across completed
  // orders (falls back to the most recent order if nothing repeats yet).
  // Shape: [{ itemName, quantity }] — matched to a chosen stall's current
  // menu by name at suggestion time, since ids are stall-specific.
  usualOrderItems    Json?       @map("usual_order_items")
  // Top items by total quantity across all completed orders, independent of
  // which combination they appeared in. Shape: [{ itemName, count }].
  favoriteItems      Json?       @map("favorite_items")
  ordersAnalyzed     Int         @default(0) @map("orders_analyzed")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  favoriteStall Stall?  @relation(fields: [favoriteStallId], references: [id])

  @@map("student_preferences")
}

model Stall {
  id            String      @id @default(uuid())
  name          String
  block         String
  area          String?
  status        StallStatus @default(active)
  nightOpen     Boolean     @default(false) @map("night_open")
  openingHours  Json?       @map("opening_hours")
  pickupNote    String?     @map("pickup_note")
  // How long, past the pickup slot's end, a student has to collect a ready
  // order before it's auto-closed as a no-show. Null falls back to the
  // app-wide default (see orderService.DEFAULT_PICKUP_GRACE_MINUTES).
  pickupGraceMinutes Int?   @map("pickup_grace_minutes")
  createdAt     DateTime    @default(now()) @map("created_at")

  owners       StallOwner[]     @relation("StallOwnerStalls")
  categories   MenuCategory[]
  items        MenuItem[]
  pickupSlots  PickupSlot[]
  orders       Order[]
  favoritedBy  StudentPreference[]
  ratings      Rating[]

  // A brand can have multiple physical outlets — (block, name) is the real identity.
  @@unique([block, name])
  @@map("stalls")
}

model StallOwner {
  id           String   @id @default(uuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  googleId     String?  @unique @map("google_id")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  stalls Stall[] @relation("StallOwnerStalls")

  @@map("stall_owners")
}

model SuperAdmin {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  passwordHash   String    @map("password_hash")
  whatsappNumber String?   @map("whatsapp_number")
  googleId       String?   @unique @map("google_id")
  otpCode        String?   @map("otp_code")
  otpExpiresAt   DateTime? @map("otp_expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("super_admins")
}

model CanonicalCategory {
  id   String @id @default(uuid())
  name String @unique

  menuCategories MenuCategory[]

  @@map("canonical_categories")
}

model MenuCategory {
  id                  String   @id @default(uuid())
  stallId             String   @map("stall_id")
  canonicalCategoryId String?  @map("canonical_category_id")
  rawLabel            String   @map("raw_label")
  displayOrder         Int      @default(0) @map("display_order")

  stall             Stall              @relation(fields: [stallId], references: [id], onDelete: Cascade)
  canonicalCategory CanonicalCategory? @relation(fields: [canonicalCategoryId], references: [id])
  items             MenuItem[]

  @@unique([stallId, rawLabel])
  @@map("menu_categories")
}

model MenuItem {
  id           String   @id @default(uuid())
  stallId      String   @map("stall_id")
  categoryId   String?  @map("category_id")
  name         String
  description  String?
  basePrice    Decimal  @map("base_price") @db.Decimal(10, 2)
  isVeg        Boolean? @map("is_veg")
  imageUrl     String?  @map("image_url")
  available    Boolean  @default(true)
  // Original raw sheet row(s), kept for traceability back to the import.
  rawImportText String? @map("raw_import_text")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  stall    Stall         @relation(fields: [stallId], references: [id], onDelete: Cascade)
  category MenuCategory? @relation(fields: [categoryId], references: [id])
  variants ItemVariant[]
  orderItems OrderItem[]

  @@index([stallId])
  @@map("menu_items")
}

model ItemVariant {
  id         String  @id @default(uuid())
  menuItemId String  @map("menu_item_id")
  label      String
  price      Decimal @db.Decimal(10, 2)
  available  Boolean @default(true)

  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("item_variants")
}

model PickupSlot {
  id           String   @id @default(uuid())
  stallId      String   @map("stall_id")
  slotDate     DateTime @map("slot_date") @db.Date
  startTime    DateTime @map("start_time") @db.Time
  endTime      DateTime @map("end_time") @db.Time
  maxCapacity  Int      @map("max_capacity")
  bookedCount  Int      @default(0) @map("booked_count")

  stall  Stall   @relation(fields: [stallId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([stallId, slotDate, startTime])
  @@map("pickup_slots")
}

model Order {
  id             String      @id @default(uuid())
  // Random customer-facing order number (ORD-XXXXXXXX) — deliberately
  // unrelated to `id` or `placedAt` so it never leaks sequence, daily
  // order count, or timing. `id` stays the internal key for all lookups.
  displayId      String      @unique @map("display_id")
  studentId      String      @map("student_id")
  stallId        String      @map("stall_id")
  pickupSlotId   String      @map("pickup_slot_id")
  status         OrderStatus @default(placed)
  totalAmount    Decimal     @map("total_amount") @db.Decimal(10, 2)
  cancelledReason String?    @map("cancelled_reason")
  placedAt       DateTime    @default(now()) @map("placed_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  // --- Order SLA & Accountability ---
  // Owner has until this instant to accept/reject before the system
  // auto-rejects on their behalf (no penalty to the owner either way).
  acceptDeadline      DateTime? @map("accept_deadline")
  acceptedAt          DateTime? @map("accepted_at")
  // True only when the SYSTEM auto-rejected an unanswered order — kept
  // distinct from an owner's own reject decision so it's never counted
  // against the owner in any future accountability metric.
  autoRejected        Boolean   @default(false) @map("auto_rejected")
  // When the owner actually marked the order ready, and whether that was
  // after the pickup slot had already ended.
  readyAt             DateTime? @map("ready_at")
  slaViolation        Boolean   @default(false) @map("sla_violation")
  slaViolationMinutes Int?      @map("sla_violation_minutes")
  // Order was ready but never collected within the pickup slot + grace
  // period — closed out automatically, never counted against the owner.
  noShow              Boolean   @default(false) @map("no_show")
  noShowAt            DateTime? @map("no_show_at")

  student    Student     @relation(fields: [studentId], references: [id])
  stall      Stall       @relation(fields: [stallId], references: [id])
  pickupSlot PickupSlot  @relation(fields: [pickupSlotId], references: [id])
  items      OrderItem[]
  rating     Rating?

  @@index([stallId, status])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String  @map("order_id")
  menuItemId    String  @map("menu_item_id")
  variantId     String? @map("variant_id")
  quantity      Int
  unitPrice     Decimal @map("unit_price") @db.Decimal(10, 2)
  itemNameSnapshot String @map("item_name_snapshot")

  order    Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem     @relation(fields: [menuItemId], references: [id])
  variant  ItemVariant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

// One rating per completed order — enforced at the DB level via the unique
// constraint on orderId, not just in application code. Anonymous by design:
// students only ever see a stall's aggregate (average + count), never
// individual ratings/comments/reviewer identity; stall owners and the Super
// Admin see aggregates plus recent comments, but never which student left
// a given one — "anonymous" is a property of the rating itself, not just
// something hidden from other students.
model Rating {
  id        String        @id @default(uuid())
  orderId   String        @unique @map("order_id")
  studentId String        @map("student_id")
  stallId   String        @map("stall_id")
  stars     Int
  // Only set when stars <= 3 — matches the WhatsApp flow, which only asks
  // "what went wrong?" for a low rating.
  reason    RatingReason?
  comment   String?
  createdAt DateTime      @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])
  stall   Stall   @relation(fields: [stallId], references: [id])

  @@index([stallId])
  @@map("ratings")
}
